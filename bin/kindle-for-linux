#!/usr/bin/env python3
"""Launcher installed to /usr/bin. The package lives in /usr/share/kindle-for-linux."""
import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.join(_here, ".."), "@PKGDATADIR@"):
    if os.path.isdir(os.path.join(candidate, "kindle_for_linux")):
        sys.path.insert(0, os.path.abspath(candidate))
        break

from kindle_for_linux.app import main  # noqa: E402

sys.exit(main())
