# Maintainer: TarouZirou
#
# GitHub のデフォルトブランチから最新版をビルドします。
#   cd packaging/arch && makepkg -si
pkgname=kindle-for-linux-git
_pkgname=kindle-for-linux
pkgver=0.2.0
pkgrel=1
pkgdesc="Ultra-light e-book / manga reader (Rust, software-rendered GUI, Lean-verified core)"
arch=('x86_64' 'aarch64')
url="https://github.com/TarouZirou/Kindle-for-Linux"
license=('MIT')
# winit loads the X11 / Wayland libraries at runtime (dlopen).
depends=('gcc-libs' 'glibc' 'fontconfig' 'libxkbcommon' 'wayland'
         'libx11' 'libxcursor' 'libxrandr' 'libxi' 'libxkbcommon-x11')
makedepends=('cargo' 'git')
optdepends=('noto-fonts-cjk: 日本語の表示（推奨）'
            'poppler: PDF の表示'
            'mupdf-tools: PDF の表示（poppler の代わり）'
            'zenity: 「ファイルを開く」ダイアログ'
            'kdialog: 「ファイルを開く」ダイアログ (KDE)'
            'xdg-utils: Kindle Cloud Reader をブラウザで開く')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local ver
  ver=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)
  printf "%s.r%s.g%s" "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Unit tests + replay of every vector generated by the Lean model.
  cargo test --frozen --release
}

package() {
  cd "$_pkgname"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
}
