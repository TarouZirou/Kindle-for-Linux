[Desktop Entry]
Type=Application
Name=Kindle for Linux
GenericName=E-book Reader
GenericName[ja]=電子書籍リーダー
Comment=Ultra-light reader for Kindle, EPUB, PDF and comics
Comment[ja]=Kindle・EPUB・PDF・コミックを読む超軽量リーダー
Exec=kindle-for-linux %f
Icon=io.github.tarouzirou.KindleForLinux
Terminal=false
Categories=Office;Viewer;Literature;
MimeType=application/epub+zip;application/pdf;application/vnd.comicbook+zip;application/x-cbz;application/x-mobipocket-ebook;application/vnd.amazon.mobi8-ebook;text/plain;
Keywords=kindle;ebook;book;reader;manga;comic;epub;pdf;電子書籍;漫画;
StartupNotify=false
StartupWMClass=io.github.tarouzirou.KindleForLinux
